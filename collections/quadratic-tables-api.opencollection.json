        {
          "info": {
            "name": "Creates a new data table on the given sheet.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/files/:file_id/tables",
            "params": [
              {
                "name": "file_id",
                "value": "",
                "type": "path",
                "description": "File UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new data table on the given sheet."
        },
        {
          "info": {
            "name": "Updates table-level metadata (name, header visibility, alternating\nrow colors, etc.). Only the fields you supply are changed.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/files/:file_id/tables",
            "params": [
              {
                "name": "file_id",
                "value": "",
                "type": "path",
                "description": "File UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates table-level metadata (name, header visibility, alternating\nrow colors, etc.). Only the fields you supply are changed."
        },
        {
          "info": {
            "name": "Updates per-column settings (display name, sort, filter) on a table.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/files/:file_id/tables/columns",
