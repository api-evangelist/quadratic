                "value": "",
                "type": "path",
                "description": "File UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates per-column settings (display name, sort, filter) on a table."
        },
