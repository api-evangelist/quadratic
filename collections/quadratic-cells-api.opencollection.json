                "value": "",
                "type": "path",
                "description": "File UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Writes a 2D block of values starting at `top_left_position`."
        },
        {
